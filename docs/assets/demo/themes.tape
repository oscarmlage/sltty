Output docs/assets/demo/themes.gif

Hide
Type "./bin/sltty -demo"
Enter
Sleep 1.5s
Show

# T opens the themes; moving through them previews each one live.
Type "T"
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Down
Sleep 900ms
Sleep 400ms
Up
Sleep 800ms
Up
Sleep 800ms
Up
Sleep 800ms
Up
Sleep 800ms
Enter
Sleep 1s

# L switches the layout; any theme works in either.
Type "L"
Sleep 1.5s
Type "T"
Sleep 700ms
Down
Sleep 800ms
Down
Sleep 800ms
Enter
Sleep 1.5s
Type "L"
Sleep 1s
