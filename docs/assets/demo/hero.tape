# README hero: the whole tour in one recording.
Output docs/assets/demo/hero.gif

Hide
Type "./bin/sltty -demo"
Enter
Sleep 1.5s
Show

# Messages, with pictures and avatars.
Sleep 1s
Type "l"
Sleep 500ms
Type "kk"
Sleep 900ms

# Fuzzy finder: # for channels. Open the one with the pictures; v views them.
Ctrl+K
Sleep 400ms
Type "#help"
Sleep 700ms
Enter
Sleep 1.2s
Type "k"
Sleep 500ms
Type "v"
Sleep 1.4s
Type "l"
Sleep 900ms
Escape
Sleep 600ms

# Threads: open one and reply.
Ctrl+K
Sleep 400ms
Type "random"
Sleep 600ms
Enter
Sleep 800ms
Type "gg"
Sleep 400ms
Enter
Sleep 1.2s
Type "i"
Type "Both, please."
Sleep 500ms
Enter
Sleep 1.2s
Escape
Sleep 500ms
Escape
Sleep 700ms

# Who reacted, in tabs per emoji.
Ctrl+K
Sleep 400ms
Type "tools-team"
Sleep 500ms
Enter
Sleep 800ms
Type "k"
Sleep 400ms
Type "R"
Sleep 1.3s
Type "l"
Sleep 900ms
Escape
Sleep 500ms

# Search with Slack's syntax.
Ctrl+F
Sleep 400ms
Type "runner"
Sleep 1.4s
Escape
Sleep 400ms
Escape
Sleep 500ms

# Themes preview live while you move through them.
Type "T"
Sleep 800ms
Down
Sleep 800ms
Down
Sleep 800ms
Down
Sleep 800ms
Down
Sleep 800ms
Down
Sleep 800ms
Up
Sleep 700ms
Up
Sleep 700ms
Enter
Sleep 900ms

# Another layout.
Type "L"
Sleep 1.3s
Type "L"
Sleep 800ms

# Activity feed, then the command line.
Ctrl+K
Sleep 400ms
Type "activity"
Sleep 500ms
Enter
Sleep 1.4s
Type ":theme aubergine"
Sleep 500ms
Enter
Sleep 900ms

# Settings and the key list.
Type ";"
Sleep 1.2s
Escape
Sleep 400ms
Type "?"
Sleep 1.2s
Type "l"
Sleep 700ms
Type "l"
Sleep 900ms
Escape
Sleep 600ms
